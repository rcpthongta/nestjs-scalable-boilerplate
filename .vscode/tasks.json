{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build The Application (Development)",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build The Application (Staging)",
      "type": "shell",
      "command": "npm run build:staging",
      "group": "build"
    },
    {
      "label": "Build The Application (Production)",
      "type": "shell",
      "command": "npm run build:production",
      "group": "build"
    },
    {
      "label": "Test The Application (All Tests)",
      "type": "shell",
      "command": "npm run test",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Test The Application (Unit Tests)",
      "type": "shell",
      "command": "npm run test:unit",
      "group": "test"
    },
    {
      "label": "Test The Application (E2E Tests)",
      "type": "shell",
      "command": "npm run test:e2e",
      "group": "test"
    }
  ]
}
