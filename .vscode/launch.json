{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Application Debug",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:debug"
      ],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "stopOnEntry": false
    }
  ]
}
