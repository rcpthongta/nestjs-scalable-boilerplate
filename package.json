    "url": "https://github.com/rcpthongta/nestjs-scalable-boilerplate/issues"
  },
  "private": true,
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "scripts": {
    "lint": "eslint **/*.{*rc,cjs,js,json,json5,jsonc,jsonl,md,mjs,ts,yaml,yml}",
