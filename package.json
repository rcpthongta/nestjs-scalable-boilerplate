{
  "name": "nestjs-scalable-boilerplate",
  "version": "0.0.1",
  "description": "A minimal and scalable NestJS boilerplate using Express.js and Webpack (with SWC), designed for building production-ready backend applications",
  "author": "rcpthongta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcpthongta/nestjs-scalable-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/rcpthongta/nestjs-scalable-boilerplate/issues"
  },
  "private": true,
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "scripts": {
    "install:husky": "husky",
    "precommit": "lint-staged",
    "prepush": "npm run test:unit",
    "build": "cross-env NODE_ENV=development nest build",
    "build:staging": "cross-env NODE_ENV=staging nest build",
    "build:production": "cross-env NODE_ENV=production nest build",
    "dev": "cross-env NODE_ENV=development nest start -w",
    "dev:debug": "cross-env NODE_ENV=development nest start -d -w",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:unit-watch": "jest --watch",
    "test:unit-coverage": "jest --coverage",
    "test:e2e": "jest --config ./e2e/jest-e2e.config.mjs",
    "test:e2e-watch": "jest --config ./e2e/jest-e2e.config.mjs --watch",
    "lint": "eslint **/*.{*rc,cjs,js,json,json5,jsonc,jsonl,md,mjs,ts,yaml,yml}",
    "lint:fix": "eslint --fix **/*.{*rc,cjs,js,json,json5,jsonc,jsonl,md,mjs,ts,yaml,yml}"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^7.5.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@suites/di.nestjs": "^3.1.0",
    "@suites/doubles.jest": "^3.1.0",
    "@suites/unit": "^3.1.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/source-map-support": "^0.5.10",
    "@types/supertest": "^7.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-yml": "^1.19.1",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsonc-eslint-parser": "^2.4.2",
    "lint-staged": "^17.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.2",
    "yaml-eslint-parser": "^1.3.2"
  }
}
